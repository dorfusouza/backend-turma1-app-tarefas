# Copie este arquivo para ".env" e ajuste para o SEU SQL Server.
# O arquivo ".env" NUNCA vai para o GitHub (está no .gitignore).
#
# Login do Windows: não há usuário nem senha aqui. O SQL Server reconhece o seu usuário do Windows.
# DB_SERVER = o nome que aparece na tela de login do SSMS ("Server name"). No Express costuma ser:
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=demo_tarefas
# Driver ODBC do Windows. Só mude se aparecer o erro "Data source name not found" (veja o README).
DB_DRIVER=SQL Server
